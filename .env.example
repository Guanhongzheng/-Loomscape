# ---------------------------------------------------------------------------
# Provider credentials are optional. The application also accepts a key at
# runtime from Settings and keeps it in IndexedDB, never on the server.
# Use this file when you prefer a shared, server-side default for a deployment.
# ---------------------------------------------------------------------------

# Text / multimodal completion endpoints (OpenAI-compatible)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Image generation
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Embeddings (OpenAI-compatible)
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3

# Speech to text
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1

# Optional: comma separated origins allowed to call /api/*
ALLOWED_ORIGINS=
