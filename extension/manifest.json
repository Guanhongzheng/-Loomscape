{
  "manifest_version": 3,
  "name": "Loomscape AI Cursor",
  "version": "0.1.0",
  "description": "A visible AI cursor that can find, highlight, click, scroll and type on the current page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Loomscape AI Cursor"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-cursor": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Open the Loomscape AI Cursor command bar"
    }
  }
}
